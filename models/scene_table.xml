<!--
  场景：工作台 + UR5e 机械臂 + 灯光 + 可抓取物体
  通过 include 合并机械臂本体，便于切换场景/任务。
-->
<mujoco model="scene_table">
  <compiler angle="radian" coordinate="local" autolimits="true" meshdir="meshes"/>

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.18 0.22 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.5 0.6 0.7" rgb2="0 0 0" width="256" height="256"/>
    <texture name="floor_tex" type="2d" builtin="checker" width="512" height="512" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="8 8" reflectance="0.2"/>
    <material name="table_mat" rgba="0.4 0.3 0.2 1"/>
  </asset>

  <default>
    <joint damping="0.5" frictionloss="0.01"/>
    <geom contype="1" conaffinity="1"/>
  </default>

  <!-- 机械臂本体（顶层 include，合并 asset/worldbody/actuator） -->
  <include file="ur5e_gripper.xml"/>

  <worldbody>
    <light name="spot" pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="floor_mat"/>

    <!-- 工作台：桌面表面 z=0.67985，承接机械臂 0.1m 底座 -->
    <!-- <body name="table" pos="0 0.5 0">
      <geom name="table_top" type="box" pos="0 0 0.85985" size="0.5 0.5 0.02" material="table_mat"/>
      <geom name="table_leg1" type="box" pos="0.45 0.45 0.419925" size="0.02 0.02 0.419925"/>
      <geom name="table_leg2" type="box" pos="-0.45 0.45 0.419925" size="0.02 0.02 0.419925"/>
      <geom name="table_leg3" type="box" pos="0.45 -0.45 0.419925" size="0.02 0.02 0.419925"/>
      <geom name="table_leg4" type="box" pos="-0.45 -0.45 0.419925" size="0.02 0.02 0.419925"/>
    </body>

    <!-- 可抓取物体（任务可动态生成/重置），放在新桌面顶面 z=0.87985 上 -->
    <body name="object" pos="0 0.5 0.91485">
      <freejoint/>
      <geom name="object" type="box" size="0.035 0.035 0.035" rgba="0.9 0.2 0.2 1" mass="0.1"/>
    </body> -->

    <!-- 充电枪 1：freejoint 使其可被抓取移动，初始由 eq_socgun_1 weld 固定在插座 -->
    <body name="charging_gun_1" pos="1.0888363 -0.073997 0.831233" quat="0.608761 0 0.793353 0">
      <freejoint/>
      <geom name="gun_col_1" type="cylinder" size="0.025 0.05" rgba="0.9 0.2 0.2 1" mass="0.1"/>
      <geom name="gun_col_2" type="box" size="0.01 0.03 0.06" rgba="0.9 0.2 0.2 1" pos="0.01 0 -0.309" quat="1 0 1 0"/>
      <geom name="gun_col_3" type="box" size="0.01 0.03 0.04" rgba="0.9 0.2 0.2 1" pos="-0.047100 0 -0.2680715" quat="1 0 0 0"/>
      <geom name="gun_col_4" type="box" size="0.01 0.03 0.04" rgba="0.9 0.2 0.2 1" pos="0.065 0 -0.2680715" quat="1 0 0 0"/>
      <geom name="gun_col_5" type="box" size="0.01 0.03 0.06" rgba="0.9 0.2 0.2 1" pos="0.0 0 -0.22780715" quat="1 0 1 0"/>
      <!-- 枪头圆盘独立为子 body gun_pan（无 joint，随枪体刚性运动）：
           插入成功判定 = gun_pan 与 car_socket 发生接触 -->
      <body name="gun_pan">
        <geom name="gun_col_6" type="cylinder" size="0.05 0.01" rgba="0.9 0.2 0.2 1" pos="0.0 0 -0.1" quat="1 0 0 0" solref="0.06 1"/>
      </body>
      <site name="gun_site_1" type="sphere" rgba="1 0 1 1" size="0.01" quat="1 0 0 -1" pos="0 0 -0.3058310"/>
      <site name="gun_site_2" type="sphere" rgba="1 0 1 1" size="0.01" quat="1 0 0 -1" pos="0 0 -0.3958310"/>
      <site name="gun_site" type="sphere" rgba="1 0 1 1" size="0.01" quat="1 0 0 -1" pos="0 0 0"/>
    </body>

    <!-- 充电插座 -->
    <body name="charing_socket" pos="-0.2276 -0.073997 0.8652439" quat="1 0 -1 0">
      <geom  type="box" size="0.003111 0.0477071 0.0090" pos="0.0647513 0 0" euler="0 1.5708 0" rgba="0.9 0.2 0.2 1"/>
      <geom  type="box" size="0.003111 0.0477071 0.00631"  pos="-0.0679513 0 0" euler="0 1.5708 0" rgba="0.9 0.2 0.2 1"/>
      <geom  type="box" size="0.006111 0.0077071 0.004012" pos="0.0 0.0600513 0" euler="0 0 0" rgba="0.9 0.2 0.2 1"/>
      <geom  type="box" size="0.006111 0.0077071 0.004012" pos="0.0  -0.0600513 0" euler="0 0 0" rgba="0.9 0.2 0.2 1"/>
      <body pos="-0.02224507183 0 -0.02793572044" quat="0.9909 0 0.1348 0">
        <replicate count="60" euler="0 0 0.10472">
          <geom type="box" pos="0.0373038 0 -0.023550" size="0.003111 0.0077071 0.023750" euler="0 0 0" rgba="0.8 0 0 0"/>
        </replicate>
        <replicate count="60" euler="0 0 0.10472">
          <geom type="box" pos="0.01812543233 0.03511920368 0.0083194332" size="0.000111 0.0027071 0.00999215143" euler="-0.5182 0.2094 1.1272" rgba="0.8 0 0 0"/>
        </replicate>
        <replicate count="40" euler="0 0 0.10472">
          <geom type="box" pos="-0.0286881 -0.0491817 0.0215" size="0.000111 0.0027071 0.010650" euler="0.4382 -0.3094 1.1272" rgba="0.8 0 0 0"/>
        </replicate>
      </body>
      <site name="charing_site_1" type="sphere" rgba="1 0 1 1" size="0.01" quat="0.0953 0.7007 -0.7007 -0.0953" pos="-0.02 0 0"/>
      <site name="charing_site_2" type="sphere" rgba="1 0 1 1" size="0.01" quat="0.0953 0.7007 -0.7007 -0.0953" pos="-0.01 0 0.07"/>
      <!-- 归位到位检测盘：薄圆盘（r=0.04 > 枪头 col_1 的 0.025）位于
           弹片通道内，姿态与弹片子 body 对齐。枪插入到底时枪体抵住即到位 -->
      <body name="charing_pan" pos="-0.033 0 -0.065" quat="0.9909 0 0.1348 0">
        <geom  type="cylinder" size="0.04 0.001" rgba="0.2 0.8 0.2 1" solref="0.06 1" priority="1"/>
      </body>
    </body>

    <!-- 车辆插座 -->
    <body name="car_socket" pos="0.3 -0.875 1.05" quat="0.541675 -0.454519 -0.454519 -0.541675">
      <site name="car_site_1" type="sphere" rgba="1 0 1 1" size="0.01" quat="0 0.7071 -0.7071 0" pos="0 0 0"/>
      <site name="car_site_2" type="sphere" rgba="1 0 1 1" size="0.01" quat="0 0.7071 -0.7071 0" pos="0 0 0.1"/>
      <site name="car_site_done" type="sphere" rgba="1 0 1 1" size="0.01" quat="0 0.7071 -0.7071 0" pos="0 0 -0.1"/>
      <replicate count="60" euler="0 0 0.10472">
        <geom type="box" pos="0 -0.0333038 -0.0005" size="0.00111 0.007071 0.02650" euler="-0.78540 1.57080 0" rgba="0.8 0 0 1"/>
      </replicate>
      <replicate count="30" offset="0 -0.001 0" euler="0 0 0">
        <geom type="box" pos="0.029100 0.0133829 -0.0005" size="0.000011 0.0007071 0.0007070" euler="0 0.78540 0" rgba="0.8 0 0 1"/>
      </replicate>
      <replicate count="60" euler="0 0 0.10472">
        <geom type="box" pos="0.0373038 0 -0.023550" size="0.003111 0.0077071 0.023750" euler="0 0 0" rgba="0.8 0 0 1"/>
      </replicate>
    </body>
  </worldbody>

  <!-- 焊接约束：
       eq_socgun_1: 充电枪 1 固定到充电插座（初始 active=true，抓取后置 false）
       eq_gun_ee: 充电枪 1 固定到末端 gripper_base（初始 active=false，抓取成功后置 true，
                  代码会在激活瞬间写入当前相对位姿，保证 weld 保持抓取姿态） -->
  <equality>
    <weld name="eq_socgun_1" body1="charing_socket" body2="charging_gun_1" active="true" anchor="0 0 0"/>
    <weld name="eq_gun_ee" body1="gripper_base" body2="charging_gun_1" active="false" anchor="0 0 0"/>
  </equality>

  <!-- 六维力传感器：读取作用在 gun_site 所在 body(charging_gun_1) 上的合力/合力矩
       读数为 subtree 合力(含重力)，代码侧需做重力补偿得到纯接触力 -->
  <sensor>
    <force name="gun_force" site="gun_site"/>
    <torque name="gun_torque" site="gun_site"/>
  </sensor>
</mujoco>
